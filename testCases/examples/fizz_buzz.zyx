# This program is a rendition of common problem - FizzBuzz
# The implementation slightly differs due to current language restrictions

int counter = 1;
int max = 30;

while(counter < max) {
    if(counter % 3 == 0) {
        print("Fizz");
    }

    if (counter % 5 == 0) {
        print("Buzz");
    }

    print(counter);
    print("---");
    counter = counter + 1;
}